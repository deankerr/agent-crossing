{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "allowedExperimentalApis": ["effect/ai/McpClient"],
        "allowedUnstableApis": [
          "@effect/platform-bun/BunFileSystem",
          "@effect/platform-bun/BunRuntime",
          "effect/ai/McpProtocol",
          "effect/ai/McpServer",
          "effect/ai/Tool",
          "effect/ai/Toolkit",
          "effect/ConfigProvider",
          "effect/http/FetchHttpClient",
          "effect/http/HttpRouter",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
